{
  "name": "trailtracker-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next",
    "gen:cli": "node scripts/generate-cli-reference.mjs",
    "build": "npm run gen:cli && next build",
    "postbuild": "pagefind --site out --output-path out/_pagefind",
    "start": "npx serve out",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^16.0.7",
    "nextra": "^4.0.0",
    "nextra-theme-docs": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "overrides": {
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.8",
    "pagefind": "^1.3.0",
    "typescript": "^5.5.0"
  }
}
