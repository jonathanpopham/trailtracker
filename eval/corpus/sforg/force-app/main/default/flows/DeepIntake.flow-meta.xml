<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Deep Intake</label><status>Active</status>
    <processType>AutoLaunchedFlow</processType>
    <start><connector><targetReference>Validate_Referral</targetReference></connector></start>
    <assignments><name>Validate_Referral</name>
        <connector><targetReference>Lookup_Patient</targetReference></connector>
    </assignments>
    <recordLookups><name>Lookup_Patient</name>
        <object>Case__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Status__c</queriedFields>
        <filters>
            <field>Referral__c</field>
            <operator>EqualTo</operator>
            <value><elementReference>Validate_Referral</elementReference></value>
        </filters>
        <connector><targetReference>Decide_Eligible</targetReference></connector>
    </recordLookups>
    <decisions><name>Decide_Eligible</name>
        <rules><name>Is_Eligible</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Lookup_Patient.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue><elementReference>Validate_Referral</elementReference></rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Lookup_Patient.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue><booleanValue>false</booleanValue></rightValue>
            </conditions>
            <connector><targetReference>Create_Case</targetReference></connector>
        </rules>
        <defaultConnector><targetReference>Assign_Pharmacist</targetReference></defaultConnector>
    </decisions>
    <recordCreates><name>Create_Case</name>
        <object>Case__c</object>
        <inputAssignments>
            <field>Status__c</field>
            <value><stringValue>Open</stringValue></value>
        </inputAssignments>
        <inputAssignments>
            <field>Patient__c</field>
            <value><elementReference>Lookup_Patient.Id</elementReference></value>
        </inputAssignments>
        <connector><targetReference>Assign_Pharmacist</targetReference></connector>
    </recordCreates>
    <assignments><name>Assign_Pharmacist</name>
        <assignmentItems>
            <assignToReference>Case__c.OwnerId</assignToReference>
            <operator>Assign</operator>
            <value><elementReference>Lookup_Patient.OwnerId</elementReference></value>
        </assignmentItems>
        <connector><targetReference>Schedule_Review</targetReference></connector>
    </assignments>
    <assignments><name>Schedule_Review</name>
        <connector><targetReference>Notify_Family</targetReference></connector>
    </assignments>
    <assignments><name>Notify_Family</name>
        <connector><targetReference>Log_Outreach</targetReference></connector>
    </assignments>
    <recordUpdates><name>Log_Outreach</name>
        <object>Case__c</object>
        <connector><targetReference>Check_Response</targetReference></connector>
    </recordUpdates>
    <assignments><name>Check_Response</name>
        <connector><targetReference>Escalate</targetReference></connector>
        <faultConnector><targetReference>Notify_Family</targetReference></faultConnector>
    </assignments>
    <assignments><name>Escalate</name>
        <connector><targetReference>Close</targetReference></connector>
    </assignments>
    <assignments><name>Close</name>
    </assignments>
</Flow>
