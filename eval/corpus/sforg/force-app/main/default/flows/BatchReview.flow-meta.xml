<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>Batch Review</label>
    <status>Active</status>
    <processType>AutoLaunchedFlow</processType>
    <variables>
        <name>patientName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>caseList</name>
        <dataType>SObject</dataType>
        <objectType>Case__c</objectType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
    <formulas>
        <name>Greeting</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!patientName}), TEXT(Case__c.Status__c), {!patientName})</expression>
    </formulas>
    <constants>
        <name>DefaultStatus</name>
        <dataType>String</dataType>
        <value><stringValue>Open</stringValue></value>
    </constants>
    <textTemplates>
        <name>SummaryTemplate</name>
        <text>Reviewed {!patientName}</text>
    </textTemplates>
    <start><connector><targetReference>Process_Cases</targetReference></connector></start>
    <loops>
        <name>Process_Cases</name>
        <collectionReference>caseList</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector><targetReference>Touch_Case</targetReference></nextValueConnector>
        <noMoreValuesConnector><targetReference>Summarize</targetReference></noMoreValuesConnector>
    </loops>
    <recordUpdates>
        <name>Touch_Case</name>
        <object>Case__c</object>
        <inputAssignments>
            <field>Status__c</field>
            <value><elementReference>DefaultStatus</elementReference></value>
        </inputAssignments>
        <connector><targetReference>Process_Cases</targetReference></connector>
        <faultConnector><targetReference>Summarize</targetReference></faultConnector>
    </recordUpdates>
    <screens>
        <name>Summarize</name>
        <fields>
            <name>DisplaySummary</name>
            <fieldType>DisplayText</fieldType>
        </fields>
        <fields>
            <name>ConfirmClose</name>
            <fieldType>InputField</fieldType>
        </fields>
        <connector><targetReference>Await_Ack</targetReference></connector>
    </screens>
    <waits>
        <name>Await_Ack</name>
        <waitEvents>
            <name>Resume_On_Ack</name>
            <connector><targetReference>Finish</targetReference></connector>
        </waitEvents>
        <defaultConnector><targetReference>Finish</targetReference></defaultConnector>
    </waits>
    <assignments>
        <name>Finish</name>
    </assignments>
</Flow>
